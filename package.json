{
  "name": "stellar_spectroscopy_from_scratch",
  "version": "2.0.0",
  "description": "A self-contained executable textbook that builds the atmosphere and synthesis physics of Payne Zero from scratch.",
  "scripts": {
    "build": "python3 scripts/build_book.py",
    "coverage": "python3 scripts/audit_paynezero_source.py && python3 scripts/build_symbol_coverage.py",
    "source-parity": "python3 scripts/verify_pinned_source_fragments.py",
    "serve": "python3 -m http.server 8899",
    "test": "python3 scripts/verify_pinned_source_fragments.py && python3 -m pytest"
  },
  "keywords": [
    "stellar-spectroscopy",
    "stellar-atmospheres",
    "payne-zero",
    "numba",
    "pytorch"
  ],
  "author": "Yuan-Sen Ting",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "highlight.js": "^11.9.0",
    "katex": "^0.16.11",
    "marked": "^12.0.2"
  }
}
